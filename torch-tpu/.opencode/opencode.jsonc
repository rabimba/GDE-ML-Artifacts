{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 3
  },
  "mcp": {
    "colab-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.13",
        "--index",
        "https://pypi.org/simple",
        "git+https://github.com/googlecolab/colab-mcp"
      ],
      "timeout": 60000
    }
  }
}
